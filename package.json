{
  "name": "hebuza-server",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "HEBUZA backend: NestJS HTTP API (src/main.ts) and worker (src/worker.ts) — one codebase, two processes.",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"concurrently -n api,worker \\\"node --enable-source-maps dist/main.js\\\" \\\"node --enable-source-maps dist/worker.js\\\"\"",
    "build": "tsup && node dist/openapi.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "openapi": "tsup && node dist/openapi.js",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:purge-demo": "tsx src/db/seed/purge.ts",
    "db:reset": "tsx src/db/seed/reset.ts && drizzle-kit migrate && tsx src/db/seed/index.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "admin:create": "tsx src/admin-create.ts",
    "owner:account": "tsx src/owner-account.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@aws-sdk/client-s3": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.840.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/swagger": "^11",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/nestjs": "^11.14.0",
    "@types/qrcode": "^1.5.6",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.8",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "nestjs-cls": "^6.0.1",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^4.3.1",
    "otplib": "^12.0.1",
    "pdf-lib": "1.17.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.6.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/core": "^1.12.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "9.39.5",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.73.0",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@9.15.9"
}
