# Generated from src/core/config/env.ts: names only, never commit values. See docs/KEYS.md for where each comes from.

NODE_ENV=  # default "development"
PORT=  # default 4000
WEB_ORIGIN=  # required; comma-separated allow-list
DATABASE_URL=  # required
DB_POOL_MAX=  # default 10
REDIS_URL=  # required
JWT_PRIVATE_KEY=  # required
JWT_PUBLIC_KEY=  # required
FIELD_KEY=  # required
BLIND_INDEX_KEY=  # required
S3_ENDPOINT=  # required
S3_BUCKET=  # required
S3_ACCESS_KEY=  # required
S3_SECRET_KEY=  # required
S3_REGION=  # default "us-east-1"
RESEND_API_KEY=  # optional
MAIL_FROM=  # required
SMS_PROVIDER=  # optional
# Africa's Talking (SMS_PROVIDER=africastalking). AT_USERNAME "sandbox" uses the sandbox host.
AT_USERNAME=  # optional
AT_API_KEY=  # optional
AT_SENDER_ID=  # optional
# Cloudflare AI Gateway in front of Anthropic: https://gateway.ai.cloudflare.com/v1/<account>/<gateway> + its run token.
AI_GATEWAY_URL=  # optional
AI_GATEWAY_TOKEN=  # optional
# Daily audit-log copy to the locked R2 bucket (write-only token scoped to that bucket).
AUDIT_S3_BUCKET=  # optional
AUDIT_S3_ACCESS_KEY=  # optional
AUDIT_S3_SECRET_KEY=  # optional
# Provider delivery webhooks + inbound SMS (STOP) are accepted only on /api/webhooks/notify/<token>/...; unset → 404.
RESEND_WEBHOOK_SECRET=  # optional; whsec_… from the Resend webhook; set → svix signature required
NOTIFY_WEBHOOK_TOKEN=  # optional
# Read-only view of the external backup job's status (server/backup/backup.sh → status/LATEST-<env>.json). Unset → dormant.
BACKUP_STATUS_ENDPOINT=  # optional
BACKUP_STATUS_BUCKET=  # optional
BACKUP_STATUS_ACCESS_KEY=  # optional
BACKUP_STATUS_SECRET_KEY=  # optional
BACKUP_STATUS_ENV=  # optional; RAILWAY_ENVIRONMENT_NAME of the backed-up env; default "production"
ANTHROPIC_API_KEY=  # optional
VOYAGE_API_KEY=  # optional; assistant embeddings (voyage-3.5); unset → full-text retrieval only
AI_MODEL=  # default "claude-sonnet-5-5"; public assistant answers
AI_FAST_MODEL=  # default "claude-haiku-5-5"; copilot rewrites + eval runs
AI_DAILY_TOKEN_BUDGET=  # default 2_000_000; all sessions, per Kigali day (Redis)
AI_SESSION_TOKEN_BUDGET=  # default 60_000; in+out per assistant session
TURNSTILE_SECRET_KEY=  # optional
CLAMAV_HOST=  # optional
REVALIDATE_SECRET=  # optional; HMAC key for the web /hooks/revalidate webhook (cms)
# payments (all optional: a method without keys answers through the dev stub, production 503)
MTN_MOMO_SUBSCRIPTION_KEY=  # optional
MTN_MOMO_API_USER=  # optional
MTN_MOMO_API_KEY=  # optional
MTN_MOMO_TARGET_ENVIRONMENT=  # optional; "sandbox" (default) or the MTN production target
AIRTEL_CLIENT_ID=  # optional
AIRTEL_CLIENT_SECRET=  # optional
AIRTEL_BASE_URL=  # optional
FLUTTERWAVE_SECRET_KEY=  # optional
FLUTTERWAVE_WEBHOOK_SECRET=  # optional
PAYMENTS_STUB=  # default "false"; dev stub driver + unsigned MoMo callbacks
PAYMENTS_WEBHOOK_SECRET=  # optional; HMAC for the MoMo callback URL (required in production)
API_PUBLIC_URL=  # optional; public API origin for gateway callbacks and feed links; default WEB_ORIGIN
# marketing WhatsApp (unset → sends are logged)
WHATSAPP_ACCESS_TOKEN=  # optional
WHATSAPP_PHONE_NUMBER_ID=  # optional
RATE_LIMIT_FACTOR=  # default 1; staging test runs only; forced to 1 in production (core/auth/rate.ts)
WORKER_MODE=  # default "separate"; inline: API process also runs jobs; off: no worker monitor (tests)
ORIGIN_AUTH_SECRET=  # optional; Phase L: Cloudflare Transform Rule header x-origin-auth; unset → no gate
SENTRY_DSN=  # optional; unset → Sentry off (core/sentry.ts)
GIT_SHA=  # optional; appended to package.json version for the API/worker version check
LOG_LEVEL=  # default "info"

# Script-only (not read by the API/worker)
ADMIN_EMAIL=  # admin:create
ADMIN_NAME=  # admin:create
ADMIN_PASSWORD=  # admin:create
MIGRATIONS_DIR=  # db:migrate:prod override
DIRECT_DATABASE_URL=  # migrations bypassing a pooler
ALLOW_SEED=  # seed/purge guard on non-dev targets
SEED_SCOPE=  # seed subset
