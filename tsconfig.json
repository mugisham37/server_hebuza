{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "forceConsistentCasingInFileNames": true, "noEmit": true, "incremental": true, "tsBuildInfoFile": "node_modules/.cache/tsc.tsbuildinfo",
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "types": ["node"], "outDir": "dist",
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "tsup.config.ts", "drizzle.config.ts", "vitest.config.ts"]
}
